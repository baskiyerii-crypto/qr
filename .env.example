# SQLite (Docker gerekmez — geliştirme için artık PostgreSQL önerilir, bkz. apps/api/.env.example)
# DATABASE_URL="file:./prisma/dev.db"

# Redis (opsiyonel — kapalıyken bildirimler sadece DB'ye yazılır)
REDIS_DISABLED="true"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# PostgreSQL kullanmak için (docker compose up -d):
# DATABASE_URL="postgresql://qr:qr_dev_password@localhost:5432/qr_personel?schema=public"
# REDIS_DISABLED="false"

JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_REFRESH_SECRET="change-me-refresh-secret-long-random"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
API_PORT=3001
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"
VITE_API_URL="/api"

