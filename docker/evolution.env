# Evolution API — QR Personel dev ortamı (docker-compose)
SERVER_NAME=qr-evolution
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080

CORS_ORIGIN=*
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error

DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution_dev_password@evolution-postgres:5432/evolution_api?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=qr_personel

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=qr_evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

AUTHENTICATION_API_KEY=qr_evolution_dev_key_7f3a9b2c
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

CONFIG_SESSION_PHONE_CLIENT=QR Personel
CONFIG_SESSION_PHONE_NAME=Chrome

DEL_INSTANCE=false
LANGUAGE=en
