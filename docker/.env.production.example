# Production ortam değişkenleri — Coolify veya docker compose için kopyalayın:
#   cp docker/.env.production.example .env.production
# Şifreleri ve anahtarları mutlaka değiştirin.
#
# Coolify checklist (404 "page not found" için):
#   1. Domain'i SADECE "web" servisine bağlayın, port = 80
#   2. redis veya api servisine domain bağlamayın
#   3. Aşağıdaki zorunlu env'leri Coolify → Environment Variables'a yapıştırın
#   4. CORS_ORIGIN ve WEB_APP_URL = Coolify'daki tam domain (http/https dahil)

# --- PostgreSQL (Coolify harici DB — internal connection string) ---
DATABASE_URL=postgresql://qr:change-me-strong-postgres-password@postgresql-database-xxxxx:5432/qr_personel?schema=public

# Yerel test (docker-compose.prod.local.yml ile compose içi postgres):
# POSTGRES_USER=qr
# POSTGRES_PASSWORD=change-me-strong-postgres-password
# POSTGRES_DB=qr_personel

# --- JWT (uzun rastgele değerler) ---
JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Uygulama ---
# Coolify sslip.io örneği:
# CORS_ORIGIN=http://xxxxx.178.105.161.134.sslip.io
# WEB_APP_URL=http://xxxxx.178.105.161.134.sslip.io
API_PORT=3001
CORS_ORIGIN=https://app.ornekdomain.com
WEB_APP_URL=https://app.ornekdomain.com
# İlk deploy'da demo hesaplar için true, sonra false
RUN_DB_SEED=false

# --- Redis ---
REDIS_DISABLED=false

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=change-me-evolution-api-key
EVOLUTION_INSTANCE_NAME=qr-personel
EVOLUTION_POSTGRES_PASSWORD=change-me-evolution-postgres-password
EVOLUTION_SERVER_URL=https://evolution.ornekdomain.com

# --- iyzico (opsiyonel) ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_CALLBACK_URL=https://app.ornekdomain.com/api/billing/iyzico/callback
