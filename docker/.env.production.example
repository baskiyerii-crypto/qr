# Production ortam değişkenleri — Coolify veya docker compose için kopyalayın:
#   cp docker/.env.production.example .env.production
# Şifreleri ve anahtarları mutlaka değiştirin.
#
# Coolify checklist (502 Bad Gateway / DB ağ hatası için):
#   1. Domain'i SADECE "web" servisine bağlayın, port = 80
#   2. redis / api / postgres servisine domain bağlamayın
#   3. Aşağıdaki zorunlu env'leri Coolify → Environment Variables'a yapıştırın
#   4. CORS_ORIGIN ve WEB_APP_URL = Coolify'daki tam domain (http/https dahil)
#   5. ESKİ harici DATABASE_URL varsa SİLİN (compose artık host=postgres kullanır)
#   6. İlk deploy'da RUN_DB_SEED=true → redeploy → sonra false

# --- PostgreSQL (compose içi — host adı "postgres", aynı Docker ağı) ---
POSTGRES_USER=qr
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=qr_personel
# DATABASE_URL artık compose tarafından otomatik üretilir:
#   postgresql://qr:...@postgres:5432/qr_personel?schema=public
# Coolify'da ESKİ harici DATABASE_URL satırını silin.

# --- JWT (uzun rastgele değerler) ---
JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Uygulama ---
# Coolify sslip.io örneği:
# CORS_ORIGIN=http://xxxxx.178.105.161.134.sslip.io
# WEB_APP_URL=http://xxxxx.178.105.161.134.sslip.io
API_PORT=3001
CORS_ORIGIN=https://app.ornekdomain.com
WEB_APP_URL=https://app.ornekdomain.com
# İlk deploy'da demo hesaplar için true, sonra false
RUN_DB_SEED=true

# --- Redis ---
REDIS_DISABLED=false

# --- Web Push (PWA tarayıcı bildirimleri) ---
# Production'da kendi anahtarlarınızı üretin:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=BDdOL4v41-XcEu3-ScYY7-ACBBLVOmA37zvNQ_uHGh8-wvVM-AGqnkNSTn0CETNNOHntbOzvtkii-PTpC3WBvuA
VAPID_PRIVATE_KEY=92y6N20CR7qaLztFBgzMpgMuJrn-eD3EAZumafSIAU8
VAPID_SUBJECT=mailto:admin@ornekdomain.com

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=change-me-evolution-api-key
EVOLUTION_INSTANCE_NAME=qr-personel
EVOLUTION_POSTGRES_PASSWORD=change-me-evolution-postgres-password
EVOLUTION_SERVER_URL=https://evolution.ornekdomain.com

# --- iyzico (opsiyonel) ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_CALLBACK_URL=https://app.ornekdomain.com/api/billing/iyzico/callback

# --- Bellek limitleri (OOM'u önler, throughput'u KISMAZ) ---
# Amaç: bir servis şişip diğerlerini öldürmesin. Varsayılanlar binlerce kullanıcı
# için cömerttir. Büyük sunucuda değerleri artırın; API'yi büyütürken NODE_OPTIONS
# heap tavanını da limitin ~%75'ine çekin (ör. 4g → --max-old-space-size=3072).
API_MEM_LIMIT=2g
API_MEM_RESERVATION=512m
API_NODE_OPTIONS=--max-old-space-size=1536
WEB_MEM_LIMIT=256m
REDIS_MEM_LIMIT=512m
REDIS_MAXMEMORY=384mb
POSTGRES_MEM_LIMIT=1g
# WhatsApp (whatsapp profili) kullanılıyorsa:
EVOLUTION_MEM_LIMIT=768m
EVOLUTION_DB_MEM_LIMIT=512m
EVOLUTION_MANAGER_MEM_LIMIT=128m
